<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="6dip">

    <ImageView
        android:id="@+id/server_icon"
        android:layout_width="64dip"
        android:layout_height="64dip"
        android:layout_marginEnd="6dip"
        android:contentDescription="@string/icon_description" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/server_usercount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:ellipsize="none"
                android:gravity="end"
                android:singleLine="true"
                android:textAlignment="gravity"
                android:textColor="@android:color/primary_text_dark"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/server_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@id/server_usercount"
                android:paddingStart="0dip"
                android:paddingEnd="6dip"
                android:textColor="@android:color/primary_text_dark"
                android:textSize="20sp" />

        </RelativeLayout>

        <TextView
            android:id="@+id/server_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:textColor="@android:color/primary_text_dark"
            android:textSize="16sp"
            tools:targetApi="m" />

        <TextView
            android:id="@+id/server_userlist_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/userlist_header"
            android:textColor="@android:color/darker_gray" />

        <TextView
            android:id="@+id/server_playerlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dip"
            android:textColor="@android:color/primary_text_dark" />

    </LinearLayout>

</LinearLayout>
